# LiteLLM 전용 환경 파일. 앱 설정은 ../.env에서 관리한다.
# 최초 복사: cp -n litellm/.env.example litellm/.env

# 1. LiteLLM 서버·관리자 (기존 DB 사용 시 비밀번호와 SALT_KEY 유지)
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:1.105.7
LITELLM_BIND=127.0.0.1
LITELLM_DB_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=
# DB 비밀번호: 영문·숫자. MASTER_KEY: sk- 접두사. 각 비밀값은 별도로 생성.

# 2. LLM — GPT-5.4 mini / Codyssey 게이트웨이
# API_BASE: Codyssey API Base URL. API_KEY: 그 게이트웨이의 인증 키.
# OpenAI 직접 연결 시 API_BASE=https://api.openai.com/v1 및 OpenAI API 키 사용.
LLM_MODEL=openai/gpt-5.4-mini
LLM_API_BASE=
LLM_API_KEY=

# 3. VLM — Gemini 3.8 Flash / Google AI Studio
# GEMINI_MODEL은 LiteLLM용이므로 gemini/ 접두사를 포함한다.
GEMINI_MODEL=gemini/gemini-3.8-flash
GEMINI_API_KEY=

# 현재 VLM 선택. 위 Gemini 설정을 참조하며 키를 중복 입력하지 않는다.
VLM_MODEL=${GEMINI_MODEL}
VLM_API_BASE=https://generativelanguage.googleapis.com/v1beta
VLM_API_KEY=${GEMINI_API_KEY}
# Qwen은 GPU 서버에 직접 배포한다 (vLLM 사용 안 함).
# 호출 API가 준비되면 VLM_* 세 값만 해당 서버 모델·주소·인증 값으로 교체한다.
# GPU 내부 Python 직접 호출만 있다면 별도 API 또는 연결 코드가 필요하다.

# 4. 폴백 — 실제 사용 가능한 대체 모델 선정 후 입력 (현재 Compose 필수값)
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=

# VLM 폴백 모델도 이미지 입력을 지원해야 한다.
VLM_FALLBACK_MODEL=
VLM_FALLBACK_API_BASE=
VLM_FALLBACK_API_KEY=
