# cp .env.example .env 후 값 채우기. .env 는 절대 커밋하지 않는다.

# ---- 이미지 ----
DOCKERHUB_USER=
IMAGE_TAG=latest

# ---- 실행 옵션 ----
APP_ENV=production
LOG_LEVEL=INFO
HTTP_PORT=80
# AI 워커가 붙기 전까지 Mock 워커로 시연. 실제 워커가 붙으면 이 줄을 지운다.
COMPOSE_PROFILES=mock

# ---- PostgreSQL ----
# 비밀번호는 영문·숫자로 (URL에 들어가므로 특수문자 금지)
POSTGRES_USER=odyssey
POSTGRES_PASSWORD=
POSTGRES_DB=odyssey

# ---- Redis ----
# 비밀번호는 영문·숫자로 (URL에 들어가므로 특수문자 금지)
REDIS_PASSWORD=
# 이 서버의 사설 IP (hostname -I 의 첫 번째 값). GPU 서버 워커가 여기로 접속한다.
REDIS_BIND=127.0.0.1

# ---- AWS S3 ----
S3_BUCKET=odyssey-images
S3_REGION=ap-northeast-2
PRESIGN_EXPIRES_SECONDS=300
# API 서버용 IAM 사용자 키
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Mock 워커 ----
MOCK_STEP_SECONDS=1
MOCK_FAIL_RATE=0
